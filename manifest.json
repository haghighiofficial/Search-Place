{
  "manifest_version": 3,
  "name": "Search Place",
  "version": "1.0.0",
  "description": "Search Google from any location worldwide using official Google UULE geotargeting parameters.",
  "author": "Majid Haghighi",
  "homepage_url": "https://www.linkedin.com/in/haghighiofficial/",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://nominatim.openstreetmap.org/*",
    "https://photon.komoot.io/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
